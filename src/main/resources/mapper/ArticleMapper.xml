<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.luoyuanxiang.thrivex.server.mapper.ArticleMapper">

    <resultMap id="ArticleMap" type="top.luoyuanxiang.thrivex.server.entity.ArticleEntity">
        <result property="id" column="id"/>
        <result property="title" column="title" />
        <result property="description" column="description" />
        <result property="content" column="content" />
        <result property="cover" column="cover" />
        <result property="view" column="view" />
        <result property="comment" column="comment" />
        <result property="createTime" column="create_time" />
        <result property="isTop" column="is_top" />
        <result property="status" column="status" />
        <result property="password" column="password" />
        <result property="isEncrypt" column="is_encrypt" />
        <result property="isDraft" column="is_draft" />
        <result property="isDel" column="is_del" />
        <collection ofType="top.luoyuanxiang.thrivex.server.entity.CateEntity" property="cateList" select="queryCateList" column="id" />
        <collection property="tagList" ofType="top.luoyuanxiang.thrivex.server.entity.TagEntity" select="queryTagList" column="id" />
    </resultMap>

    <select id="list" resultMap="ArticleMap">
        select a.id,
        a.title,
        a.description,
        a.content,
        a.cover,
        a.view,
        a.is_top,
        a.password,
        a.create_time,
        a.status,
        a.is_del,
        a.is_draft,
        a.is_encrypt,
        (select count(*) from `comment` where article_id = a.id) as comment
        FROM article a
        <where>
            <if test="vo.ids != null and vo.ids.size() > 0">
                AND a.id in
                <foreach item="item" collection="vo.ids" separator="," open="(" close=")" index="">
                    #{item}
                </foreach>
            </if>
            <if test="vo.key != null and vo.key != ''">
                AND a.title LIKE CONCAT('%', #{vo.key}, '%')
            </if>
            <if test="vo.cateId != null">
                AND a.id in(
                select article_id
                from article_cate ac
                left join cate ct on ct.id = ac.cate_id
                where ct.id = #{vo.cateId}
                )
            </if>
            <if test="vo.tagId != null">
                AND a.id in(
                select atg.article_id
                FROM article_tag atg
                LEFT JOIN tag ta ON ta.id = atg.tag_id
                where ta.id = #{vo.tagId}
                )
            </if>
            <if test="vo.isDraft != null">
                AND a.is_draft = #{vo.isDraft}
            </if>
            <if test="vo.isDel != null">
                AND a.is_del = #{vo.isDel}
            </if>
            <if test="vo.startDate != null and vo.startDate != ''">
                AND a.create_time >= #{vo.startDate}
            </if>
            <if test="vo.endDate != null and vo.endDate != ''">
                AND a.create_time <![CDATA[<=]]> #{vo.endDate}
            </if>
            <if test="vo.isAdmin">
                AND a.status != 'hide'
            </if>
        </where>
        <choose>
            <when test="vo.randCount != null">
                order by rand() limit #{vo.randCount}
            </when>
            <otherwise>
                order by a.is_top desc, a.create_time desc
            </otherwise>
        </choose>
    </select>

    <select id="queryCateList" resultType="top.luoyuanxiang.thrivex.server.entity.CateEntity">
        select ct.id,
        ct.name,
        ct.icon,
        ct.url,
        ct.mark,
        ct.`order`,
        ct.type
        from article_cate ac
        LEFT JOIN cate ct ON ct.id = ac.cate_id
        WHERE ac.article_id = #{id}
    </select>

    <select id="queryTagList" resultType="top.luoyuanxiang.thrivex.server.entity.TagEntity">
        select ta.id,
        ta.name
        FROM article_tag atg
        LEFT JOIN tag ta ON ta.id = atg.tag_id
        WHERE atg.article_id = #{id}
    </select>
</mapper>
